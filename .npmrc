# Install scripts off (C-034): no package of ours needs one; a package that truly does is allow-listed in theGhost.md,
# by name and why, before it may run its own.
ignore-scripts=true
# npm 10 crashes on vitest 4's peer set (bridge, ASB): package.json says engines.npm >=11 and this makes npm refuse another.
engine-strict=true
