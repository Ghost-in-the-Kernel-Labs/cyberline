# The planted break for scripts/checks/secrets.py. No key is written here: test/test_secrets.py fills each slot in braces with a
# value assembled from fragments at run time, writes the result to a temporary folder, and scans that.
AWS_ACCESS_KEY_ID={aws}
GITHUB_TOKEN={github}
GH_FINE={github_pat}
SLACK_BOT={slack}
STRIPE={stripe}
GOOGLE={google}
OPENAI={openai}
ANTHROPIC={anthropic}
{private_key_header}
{private_key_body}
db_password = "{generic}"
api_key: {low_entropy}
plain_text = {no_name}
