{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "#p/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "scripts"
  ],
  "exclude": [
    "test/fixtures"
  ]
}
